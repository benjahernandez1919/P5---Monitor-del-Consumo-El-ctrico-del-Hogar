  {
    "id": "e5e0000000000020",
    "type": "function",
    "z": "e5e0000000000001",
    "name": "preparar interfaz",
    "func": "// Prepara la interfaz a partir del JSON que publica SU nodo.\n// COMPLETAR: el campo principal y los estados, en el MISMO orden que el enum de su sketch.\nconst CAMPO   = \"corriente\";  // corriente de la carga en mA (INA219)\nconst ESTADOS = [\"MEDICION\", \"CONSUMO_ALTO\", \"ERROR_SEGURO\", \"ACTUANDO_REMOTO\"];  // mismo orden que el enum SystemState\n\nconst p = msg.payload;\nlet medidor = null, serie = null, estado = null;\nif (typeof p[CAMPO] === \"number\") {\n    medidor = { payload: p[CAMPO] };\n    serie   = { topic: CAMPO, payload: p[CAMPO] };\n}\nif (typeof p.estado === \"number\") {\n    estado = { payload: (ESTADOS[p.estado] || (\"estado \" + p.estado)) + (p.sensor_ok === 0 ? \" · sensor con falla\" : \"\") };\n}\nreturn [medidor, serie, estado];",
    "outputs": 3,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 540,
    "y": 140,
